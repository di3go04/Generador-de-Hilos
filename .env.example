# Urban SaaS - AI Suite Configuration

# Image Generation Providers (stability | openai)
AI_IMAGE_PROVIDER=stability
STABILITY_API_KEY=your_stability_key_here
OPENAI_API_KEY=your_openai_key_here

# Storage
STORAGE_PROVIDER=local # local | s3
S3_BUCKET=urban-generations
S3_REGION=us-east-1
S3_ACCESS_KEY=xxx
S3_SECRET_KEY=xxx

# SaaS & Billing (Meteroid / Lago)
METEROID_API_KEY=your_meteroid_key_here
LAGO_API_KEY=your_lago_key_here

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/urban_db?schema=public"

# Auth
NEXTAUTH_SECRET=your_secret_here
NEXTAUTH_URL=http://localhost:3000
