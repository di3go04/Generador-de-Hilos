# ── Database ──────────────────────────────────
DATABASE_URL=postgres://urban:urban@localhost:5432/urban

# ── Auth (JWT) ────────────────────────────────
JWT_SECRET=change-me-to-a-random-64-char-string

# ── Auth Providers ───────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── App ───────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# ── Stripe ────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=price_pro_monthly      # Create in Stripe Dashboard → Products
STRIPE_ENTERPRISE_PRICE_ID=price_enterprise_monthly

# ── Storage (S3-compatible) ───────────────────
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=urban-videos
