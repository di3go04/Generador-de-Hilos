// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  password       String?
  role           String    @default("USER") // USER, ADMIN
  plan           String    @default("FREE") // FREE, PRO, ENTERPRISE
  banned         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  threads        Thread[]
  folders        Folder[]
  categories     Category[]
  apiKeys        ApiKey[]
  subscriptions  Subscription?
  usageRecords   UsageRecord[]
  scheduledPosts ScheduledPost[]
  twitterToken   TwitterToken?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Thread {
  id          String   @id @default(cuid())
  userId      String
  folderId    String?
  title       String
  topic       String
  content     String   // JSON array of tweets stored as string
  tone        String   @default("professional")
  language    String   @default("es")
  status      String   @default("DRAFT") // DRAFT, PUBLISHED, SCHEDULED
  publishedAt DateTime?
  twitterIds  String?  // JSON array of tweet IDs
  scheduleAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder        Folder?          @relation(fields: [folderId], references: [id])
  scheduledPost ScheduledPost?
  categories    ThreadCategory[]

  @@map("threads")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#6366f1")
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  threads ThreadCategory[]

  @@map("categories")
}

model ThreadCategory {
  threadId   String
  categoryId String

  thread   Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([threadId, categoryId])
  @@map("thread_categories")
}

model Folder {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#6366f1")
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  threads Thread[]

  @@map("folders")
}

model ApiKey {
  id        String    @id @default(cuid())
  userId    String
  name      String
  key       String    @unique
  lastUsed  DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String    @unique
  plan      String    @default("FREE")
  status    String    @default("active") // active, canceled, expired
  startDate DateTime  @default(now())
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model UsageRecord {
  id        String   @id @default(cuid())
  userId    String
  toolSlug  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("usage_records")
}

model ScheduledPost {
  id          String    @id @default(cuid())
  userId      String
  threadId    String    @unique
  scheduledAt DateTime
  publishedAt DateTime?
  status      String    @default("pending") // pending, published, failed
  error       String?
  createdAt   DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  thread Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@map("scheduled_posts")
}

model TwitterToken {
  id           String    @id @default(cuid())
  userId       String    @unique
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  twitterId    String?
  username     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("twitter_tokens")
}

model NewsletterLead {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("newsletter_leads")
}
